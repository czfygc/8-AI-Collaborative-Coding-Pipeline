{
  "schemaVersion": "v1",
  "updatedAt": "2026-10-21",
  "source": "freellmapi 目录快照（server/data/freeapi.db models 表，enabled=1，2026-10-21）+ 本仓实测（tier-groups.cjs 强档链 / Kilo+Cline 轮换记录）",
  "note": "id 用网关本地裸名（127.0.0.1:3001/v1/models 里的 id）；upstream 为上游真实 id，仅作溯源。free=true 表示免费档（铁律#1：不接付费）。",
  "gateway": {
    "baseUrl": "http://127.0.0.1:3001/v1",
    "keyEnv": "FREELLMAPI_API_KEY",
    "probeTimeoutMs": 20000
  },
  "quotaNote": {
    "openrouter": "账号级 free-models-per-day=50，四客户端共享，是最稀缺的额度",
    "kilo": "Kilo 侧免费副本，多为不限量（rpd=null）",
    "xkiro": "多模型不限量，链尾成员今天全 429 的风险来自这里",
    "routeway": "rpd=200",
    "septor": "rpd=null",
    "waterfall": "rpd=null",
    "custom": "自有额度，用完即 drained（今天 glm-5.3/kimi-k2.6 已耗尽）",
    "radeon": "AMD 原生平台双号直连，目录内 3 个强档"
  },
  "taskTiers": {
    "mechanical": {
      "label": "机械/批处理活",
      "prefer": "light",
      "allowedModelTiers": [
        "light",
        "medium",
        "heavy"
      ],
      "machineVerifiable": true,
      "allowBehaviorChange": false,
      "examples": [
        "批量改写/重命名",
        "摘要",
        "分类打标",
        "JSON/字段抽取",
        "格式修复",
        "注释补齐",
        "翻译",
        "日志归并",
        "模板填充"
      ],
      "rule": "错了一定会被机器立刻抓住（测试/正则/计数/schema）；不许做需要语义判断的活",
      "acceptance": "必须有机器可判定的验收命令（node --test / lint / 计数比对 / JSON schema）",
      "requireTools": false
    },
    "bounded_code": {
      "label": "边界清晰的实现",
      "prefer": "medium",
      "allowedModelTiers": [
        "medium",
        "heavy"
      ],
      "machineVerifiable": true,
      "allowBehaviorChange": true,
      "examples": [
        "新模块 + 单测",
        "小重构",
        "一次性脚本",
        "参数解析/CLI 加工具"
      ],
      "rule": "允许改行为，但必须自带测试；改完过闸门（verify-gate）+ 另一客户端复核",
      "acceptance": "自带验收命令 + orchestrator/verify-gate.mjs 全绿",
      "requireTools": true
    },
    "architecture": {
      "label": "架构/跨文件/协议",
      "prefer": "heavy",
      "allowedModelTiers": [
        "heavy"
      ],
      "machineVerifiable": false,
      "allowBehaviorChange": true,
      "examples": [
        "协议/门禁设计",
        "跨文件重构",
        "安全审查",
        "数据模型设计",
        "四客户端分工设计"
      ],
      "rule": "只派强档；低档在此产出会\"看起来对其实错\"的隐性事故",
      "acceptance": "设计文档 + 回归测试 + 非作者复核",
      "requireTools": true
    },
    "review": {
      "label": "只读挑错/取证",
      "prefer": "medium",
      "allowedModelTiers": [
        "medium",
        "heavy"
      ],
      "machineVerifiable": false,
      "allowBehaviorChange": false,
      "examples": [
        "代码审查",
        "只读扫描找茬",
        "证据取证",
        "文档复核"
      ],
      "rule": "只读；中档起步（漏检比慢更危险），关键安全项升强档",
      "acceptance": "findings 逐条带原始输出；作者 ≠ 验证者",
      "requireTools": false
    },
    "long_run": {
      "label": "长任务/守夜/批量回归",
      "prefer": "medium",
      "allowedModelTiers": [
        "medium",
        "heavy"
      ],
      "machineVerifiable": true,
      "allowBehaviorChange": false,
      "examples": [
        "整仓回归",
        "多轮 CDP 会诊",
        "批量取证"
      ],
      "rule": "中档够用；单轮失败不重复同模型超过 2 次",
      "acceptance": "日志落 run-events 可回放 + 终态摘要",
      "requireTools": false
    }
  },
